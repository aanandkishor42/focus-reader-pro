{
  "manifest_version": 3,
  "name": "Focus Reader Pro",
  "version": "0.3.0",
  "description": "Estimate reading time, enter a distraction-free reading mode, and opt in to local reading history.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Focus Reader Pro",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content-script.js"],
      "css": ["content/focus-mode.css"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-focus-mode": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Toggle Focus Reader distraction-free mode"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/constants.js",
        "lib/domain.js",
        "lib/storage.js",
        "lib/word-count.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
