# Optional: override the SQLite database location.
# FOCUS_READER_DB=C:\path\to\history.db

# Optional: restrict CORS to one exact extension origin. Without this, any
# chrome-extension:// origin is accepted, but normal websites are not.
# Find the ID at chrome://extensions after loading the unpacked extension.
# FOCUS_READER_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# Optional: timezone used for "today" and "week" stats. Defaults to the
# machine timezone. Examples: UTC, Asia/Kolkata, America/New_York.
# FOCUS_READER_TIMEZONE=UTC
